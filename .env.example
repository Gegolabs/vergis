# Vergis Free — variables de entorno (copiar a .env; .env NO se commitea).

# Perfil(es) de conexión SQL — JSON. Cada database_ref → su conexión.
# Para Fabric: autenticación por Service Principal.
VERGIS_CONNECTIONS={"fabric-lh-qw04":{"server":"<sql-endpoint>.datawarehouse.fabric.microsoft.com","database":"lh_qw04","tenantId":"<tenant>","clientId":"<sp-app-id>","clientSecret":"<sp-secret>","port":1433}}

# Gate básico opcional (déjalos vacíos para no gatear; en prod usar SSO/oauth2-proxy).
VERGIS_USER=
VERGIS_PASS=
