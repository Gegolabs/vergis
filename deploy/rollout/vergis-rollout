#!/bin/sh
# vergis-rollout — ALIAS RETIRADO de `botler-rollout` (#290).
#
# La herramienta se llama `botler-rollout` desde que el contrato del nodo pasó a hablar en Lets: lo que
# hospeda no es «Vergis», es un nodo Botler. Este archivo existe para que una VM con el nombre viejo en
# un runbook, un cron o los dedos del operador NO falle con «command not found» a mitad de un
# despliegue: reenvía tal cual y avisa por stderr (nunca por stdout, que es la salida que un `--json`
# entrega a quien lo parsea).
printf '%s\n' 'vergis-rollout: nombre retirado; usa botler-rollout (mismo comando, mismos argumentos)' >&2
exec "$(dirname "$0")/botler-rollout" "$@"
