{
  "name": "vergis",
  "private": true,
  "version": "0.6.1",
  "description": "Vergis — Meta-Cognitive Platform · implementación de referencia de AgencyDomains",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "vergis": "tsx packages/cli/src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "esbuild server/serve-rls.ts --bundle --platform=node --target=node22 --format=esm --external:canvas --external:mssql --external:tedious --external:sql.js --external:ajv --external:ajv-formats --external:yaml --outfile=dist/serve-rls.mjs && cp packages/capabilities/src/themes/arbol-logo.png dist/",
    "start": "node dist/serve-rls.mjs"
  },
  "license": "AGPL-3.0-or-later",
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.12",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "sql.js": "^1.14.1",
    "yaml": "^2.6.1"
  }
}
